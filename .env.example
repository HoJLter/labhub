# Скопируйте в .env и заполните. Все значения опциональны — есть дефолты.

# Публичный адрес сайта (для sitemap, OG, presigned-ссылок)
# deploy-скрипт подставит сюда ваш домен/IP автоматически при первом деплое
PUBLIC_URL=http://YOUR_SERVER_IP

# Учётка админа создаётся при первом запуске (единственный аккаунт)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=смените-этот-пароль

# Соль для HMAC(ip) в статистике — сгенерируйте: openssl rand -hex 32
IP_SALT=

# Лимиты
MAX_UPLOAD_MB=2048
CACHE_MAX_GB=20
CACHE_TTL_HOURS=168
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MIN=15

# Фоновые проверки внешних ссылок (часы)
HEALTH_CHECK_HOURS=24

# Демо-каталог при первом запуске (для прода держите 0; посмотреть демо: SEED_DEMO=1)
SEED_DEMO=0

# Секреты внешних хранилищ (на них можно ссылаться из админки как env:S3_SECRET)
# S3_SECRET=
# WEBDAV_PASSWORD=

# Бэкапы
BACKUP_KEEP=7

# Заметки (vault). Каталог с обычными .md-файлами в формате Obsidian:
# frontmatter, [[wiki-ссылки]], #теги, ![[вложения]], callouts.
# Ту же папку можно открыть в настоящем Obsidian и писать заметки там — сайт подхватит
# правки через fs.watch и переиндексирует. По умолчанию: DATA_DIR/vault
# VAULT_DIR=/srv/obsidian-vault
